---
// Franja de logos que corre sola, debajo de la galería del local. Los logos van en un
// solo tono cálido para que se sientan parte del almacén y no un muestrario de colores;
// al pasar el mouse recuperan su color.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { marcas } from '../data/site';

// Mismo peso visual para todos: el alto de cada logo sale de su proporción, así un
// logo cuadrado no queda chico al lado de uno apaisado (área parecida, alto máx. 60 px).
const alto = (logo: ImageMetadata) => Math.round(Math.min(60, Math.sqrt(5000 / (logo.width / logo.height))));

// La serie se repite hasta tener al menos 12 logos, para que la franja nunca quede corta
// en pantallas anchas; después se duplica entera para el loop sin saltos.
const serie = Array.from({ length: Math.ceil(12 / marcas.length) }, () => marcas).flat();
---

<div class="mx-auto mt-16 max-w-[1200px] px-5 lg:mt-20 lg:px-10" data-reveal>
  <div class="flex items-center gap-4">
    <p class="shrink-0 text-sm font-semibold text-marca">Marcas que elegimos</p>
    <span class="h-px flex-1 bg-arena"></span>
  </div>
</div>

<div class="marcas-viewport mt-8" aria-label="Marcas que elegimos">
  <ul class="marcas-track flex w-max items-center">
    {
      [0, 1].map((copia) =>
        serie.map((m, k) => (
          <li class="marca" aria-hidden={copia === 1 || k >= marcas.length ? 'true' : undefined}>
            <Image
              src={m.logo}
              alt={m.nombre}
              height={Math.min(m.logo.height, alto(m.logo) * 2)}
              style={`--h:${alto(m.logo)}px`}
              class="logo-marca w-auto object-contain"
              loading="lazy"
            />
          </li>
        )),
      )
    }
  </ul>
</div>

<style>
  .marca {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding: 0 28px;
  }
  .logo-marca {
    height: calc(var(--h) * 0.8);
    /* Un solo tono cálido: sin color, con un toque sepia que va con la madera del local. */
    filter: grayscale(1) sepia(0.3) contrast(1.1);
    opacity: 0.7;
    transition:
      filter 700ms var(--ease-fluid),
      opacity 700ms var(--ease-fluid);
  }
  .marca:hover .logo-marca {
    filter: none;
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .marca {
      padding: 0 44px;
    }
    .logo-marca {
      height: var(--h);
    }
  }

  /* La franja corre sola; al pasar el mouse se frena. */
  .marcas-viewport {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marcas-track {
    animation: correr 45s linear infinite;
  }
  .marcas-viewport:hover .marcas-track {
    animation-play-state: paused;
  }
  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }

  /* Sin movimiento: fila con scroll lateral y solo la primera tanda. */
  @media (prefers-reduced-motion: reduce) {
    .marcas-viewport {
      overflow-x: auto;
      mask-image: none;
    }
    .marcas-track {
      animation: none;
    }
    .marca[aria-hidden='true'] {
      display: none;
    }
  }
</style>
