---
// Fotos reales del local en una fila que avanza sola y sin fin. Se frena cuando la
// persona la toca, la desliza, pasa el mouse o enfoca un control, y retoma sola a los
// pocos segundos. El botón de pausa la detiene (junto con la franja de marcas) hasta
// que se vuelva a tocar. Sin etiquetas sobre las fotos.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import MarcasFranja from './MarcasFranja.astro';
import { galeria } from '../data/site';

// Anchos generados: los estándar que entran en la foto, más su ancho original.
const anchos = (w: number) => [400, 640, 900].filter((a) => a < w).concat(w < 900 ? [w] : []);
---

{
  galeria.length > 0 && (
    <section id="el-almacen" aria-labelledby="galeria-titulo" class="overflow-hidden pt-24 pb-10 lg:pt-32 lg:pb-16" data-galeria>
      <div class="mx-auto flex max-w-[1200px] items-end justify-between gap-6 px-5 lg:px-10">
        <div class="max-w-[680px]" data-reveal>
          <p class="mb-3 text-sm font-semibold text-marca-texto">El almacén</p>
          <h2 id="galeria-titulo" class="text-4xl font-bold tracking-tight text-profundo lg:text-5xl">
            Un lugar lindo <br />
            para hacer las compras
          </h2>
          <p class="mt-4 text-lg text-texto-2">Madera, luz cálida y góndolas ordenadas para que elegir sea un placer.</p>
        </div>
        <div class="flex shrink-0 gap-2">
          <button type="button" class="galeria-boton galeria-pausa flex" data-galeria-pausa aria-pressed="false" aria-label="Pausar el movimiento">
            <Icon name="pause" class="icono-pausa size-5" />
            <Icon name="play" class="icono-play size-5" />
          </button>
          <button type="button" class="galeria-boton hidden lg:flex" data-galeria-ir="-1" aria-label="Fotos anteriores">
            <Icon name="arrow-left" class="size-5" />
          </button>
          <button type="button" class="galeria-boton hidden lg:flex" data-galeria-ir="1" aria-label="Fotos siguientes">
            <Icon name="arrow-left" class="size-5 rotate-180" />
          </button>
        </div>
      </div>

      <ul class="galeria-fila mt-10 lg:mt-14" data-galeria-fila aria-label="Fotos del almacén">
        {[0, 1].map((copia) =>
          galeria.map((g, i) => (
            <li
              class:list={['galeria-foto', i % 3 === 1 && 'galeria-foto-baja']}
              aria-hidden={copia === 1 ? 'true' : undefined}
              data-copia={copia === 1 ? '' : undefined}
            >
              <Image
                src={g.foto}
                alt={copia === 1 ? '' : g.alt}
                widths={anchos(g.foto.width)}
                sizes="(min-width: 1024px) 300px, 64vw"
                quality={82}
                loading="lazy"
                draggable="false"
                class="size-full object-cover transition-transform duration-700 ease-fluid hover:scale-105"
              />
            </li>
          )),
        )}
      </ul>

      <MarcasFranja />
    </section>
  )
}

<style>
  .galeria-fila {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-inline: 20px;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .galeria-fila::-webkit-scrollbar {
    display: none;
  }
  .galeria-foto {
    position: relative;
    flex: 0 0 64vw;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 24px;
    background: var(--color-menta);
  }
  /* Ritmo: cada tanto una foto un poco más baja, para que la fila no sea una grilla.
     Va por índice (no nth-child) para que la copia repita el mismo patrón. */
  .galeria-foto-baja {
    aspect-ratio: 4 / 5;
    align-self: center;
  }
  @media (min-width: 1024px) {
    .galeria-fila {
      gap: 16px;
      padding-inline: max(40px, calc((100vw - 1200px) / 2 + 40px));
    }
    .galeria-foto {
      flex-basis: 300px;
    }
  }

  /* Sin `display` acá: lo ponen las clases (flex / hidden lg:flex), así en celular no aparecen las flechas. */
  .galeria-boton {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-arena);
    background: #fff;
    color: var(--color-profundo);
    transition: transform 700ms var(--ease-fluid);
  }
  .galeria-boton:hover {
    transform: scale(1.05);
  }
  .galeria-pausa :global(.icono-play),
  .galeria-pausa[aria-pressed='true'] :global(.icono-pausa) {
    display: none;
  }
  .galeria-pausa[aria-pressed='true'] :global(.icono-play) {
    display: block;
  }

  /* Sin movimiento: una sola tanda para recorrer a mano, y nada que pausar. */
  @media (prefers-reduced-motion: reduce) {
    .galeria-foto[data-copia],
    .galeria-pausa {
      display: none;
    }
  }
</style>

<script>
  // Avance automático: se lleva la posición en un número propio (scrollLeft redondea
  // y a velocidad baja se quedaría quieto). La fila tiene dos tandas iguales: al pasar
  // la primera, se vuelve atrás exactamente una tanda y el salto no se nota.
  document.querySelectorAll<HTMLElement>('[data-galeria]').forEach((sec) => {
    const fila = sec.querySelector<HTMLElement>('[data-galeria-fila]')!;
    const flechas = [...sec.querySelectorAll<HTMLButtonElement>('[data-galeria-ir]')];
    const pausa = sec.querySelector<HTMLButtonElement>('[data-galeria-pausa]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Ancho de una tanda: distancia entre la primera foto y su copia.
    let tanda = 0;
    const medir = () => {
      const copia = fila.querySelector<HTMLElement>('[data-copia]');
      tanda = copia ? copia.offsetLeft - (fila.firstElementChild as HTMLElement).offsetLeft : 0;
    };
    medir();
    new ResizeObserver(medir).observe(fila);

    const envolver = (x: number) => (!tanda ? x : x >= tanda ? x - tanda : x < 0 ? x + tanda : x);

    let pausaHasta = 0;
    const pausar = (ms: number) => (pausaHasta = performance.now() + ms);

    flechas.forEach((b) =>
      b.addEventListener('click', () => {
        pausar(1800);
        const paso = Math.max(fila.clientWidth * 0.6, 316);
        const dir = Number(b.dataset.galeriaIr);
        // Antes de moverse se salta (sin que se note) a la tanda equivalente, para que
        // el desplazamiento suave nunca cruce el borde.
        if (!reduce && tanda) {
          if (dir < 0 && fila.scrollLeft < paso) fila.scrollLeft += tanda;
          if (dir > 0 && fila.scrollLeft + paso >= tanda) fila.scrollLeft -= tanda;
        }
        fila.scrollTo({ left: fila.scrollLeft + dir * paso, behavior: reduce ? 'auto' : 'smooth' });
      }),
    );

    if (reduce) return;

    const velocidad = window.innerWidth < 1024 ? 28 : 36; // px por segundo
    let pos = fila.scrollLeft;
    let detenida = false; // con el botón de pausa
    let encima = false; // mouse encima
    let foco = false; // un control de la sección tiene el foco
    let ultimo = 0;
    let raf = 0;

    const quieta = () => detenida || encima || foco || performance.now() < pausaHasta;

    const cuadro = (t: number) => {
      const dt = ultimo ? Math.min((t - ultimo) / 1000, 0.05) : 0;
      ultimo = t;
      if (!quieta()) {
        // Si la persona movió la fila a mano, se sigue desde donde la dejó.
        if (Math.abs(fila.scrollLeft - pos) > 2) pos = fila.scrollLeft;
        pos = envolver(pos + velocidad * dt);
        fila.scrollLeft = pos;
      } else {
        // Quieta o en manos de la persona: solo se mantiene dentro de la primera tanda.
        const corregida = envolver(fila.scrollLeft);
        if (corregida !== fila.scrollLeft) fila.scrollLeft = corregida;
        pos = fila.scrollLeft;
      }
      raf = requestAnimationFrame(cuadro);
    };

    // El bucle corre solo mientras la galería está en pantalla.
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      ultimo = 0;
      if (e.isIntersecting) raf = requestAnimationFrame(cuadro);
    }).observe(fila);

    pausa?.addEventListener('click', () => {
      detenida = !detenida;
      pausa.setAttribute('aria-pressed', String(detenida));
      sec.toggleAttribute('data-pausado', detenida);
    });
    // Solo el foco de teclado frena (el clic con mouse también enfoca el botón y la dejaría quieta).
    sec.addEventListener('focusin', (e) => (foco = (e.target as HTMLElement).matches(':focus-visible')));
    sec.addEventListener('focusout', (e) => (foco = sec.contains(e.relatedTarget as Node | null)));
    fila.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && (encima = true));
    fila.addEventListener('pointerleave', () => (encima = false));
    fila.addEventListener('pointerdown', () => pausar(2500));
    fila.addEventListener('touchstart', () => pausar(2500), { passive: true });
    fila.addEventListener('touchmove', () => pausar(2500), { passive: true });
    fila.addEventListener('wheel', (e) => Math.abs(e.deltaX) > Math.abs(e.deltaY) && pausar(2500), { passive: true });
  });
</script>
