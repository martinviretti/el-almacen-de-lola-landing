---
// Fotos reales del local en una fila que avanza sola y sin fin. Se frena cuando la
// persona la toca, la desliza o pasa el mouse, y retoma sola a los pocos segundos.
// Debajo, la franja de marcas. Sin etiquetas sobre las fotos.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import MarcasFranja from './MarcasFranja.astro';
import { galeria } from '../data/site';
---

{
  galeria.length > 0 && (
    <section id="el-almacen" aria-labelledby="galeria-titulo" class="overflow-hidden pt-24 pb-10 lg:pt-32 lg:pb-16" data-galeria>
      <div class="mx-auto flex max-w-[1200px] items-end justify-between gap-6 px-5 lg:px-10">
        <div class="max-w-[680px]" data-reveal>
          <p class="mb-3 text-sm font-semibold text-marca">El almacén</p>
          <h2 id="galeria-titulo" class="text-4xl font-bold tracking-tight text-profundo lg:text-5xl">
            Un lugar lindo <br />
            para hacer las compras
          </h2>
          <p class="mt-4 text-lg text-texto-2">Madera, luz cálida y góndolas ordenadas para que elegir sea un placer.</p>
        </div>
        <div class="hidden shrink-0 gap-2 lg:flex">
          <button type="button" class="galeria-flecha" data-galeria-ir="-1" aria-label="Fotos anteriores">
            <Icon name="arrow-left" class="size-5" />
          </button>
          <button type="button" class="galeria-flecha" data-galeria-ir="1" aria-label="Fotos siguientes">
            <Icon name="arrow-left" class="size-5 rotate-180" />
          </button>
        </div>
      </div>

      <ul class="galeria-fila mt-10 lg:mt-14" data-galeria-fila aria-label="Fotos del almacén">
        {[0, 1].map((copia) =>
          galeria.map((g, i) => (
            <li class="galeria-foto" aria-hidden={copia === 1 ? 'true' : undefined} data-copia={copia === 1 ? '' : undefined}>
              <Image
                src={g.foto}
                alt={copia === 1 ? '' : g.alt}
                widths={[400, 640, 900].filter((w) => w <= g.foto.width).concat(g.foto.width < 400 ? [g.foto.width] : [])}
                sizes="(min-width: 1024px) 300px, 64vw"
                quality={82}
                loading={copia === 0 && i < 4 ? 'eager' : 'lazy'}
                draggable="false"
                class="size-full object-cover transition-transform duration-700 ease-fluid hover:scale-105"
              />
            </li>
          )),
        )}
      </ul>

      <MarcasFranja />
    </section>
  )
}

<style>
  .galeria-fila {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-inline: 20px;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .galeria-fila::-webkit-scrollbar {
    display: none;
  }
  .galeria-foto {
    position: relative;
    flex: 0 0 64vw;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 24px;
    background: var(--color-menta);
  }
  /* Ritmo: cada tanto una foto un poco más baja, para que la fila no sea una grilla. */
  .galeria-foto:nth-child(3n + 2) {
    aspect-ratio: 4 / 5;
    align-self: center;
  }
  @media (min-width: 1024px) {
    .galeria-fila {
      gap: 16px;
      padding-inline: max(40px, calc((100vw - 1200px) / 2 + 40px));
    }
    .galeria-foto {
      flex-basis: 300px;
    }
  }

  /* Sin movimiento: una sola tanda, para recorrer a mano. */
  @media (prefers-reduced-motion: reduce) {
    .galeria-foto[data-copia] {
      display: none;
    }
  }

  .galeria-flecha {
    display: flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-arena);
    background: #fff;
    color: var(--color-profundo);
    transition: transform 700ms var(--ease-fluid);
  }
  .galeria-flecha:hover {
    transform: scale(1.05);
  }
</style>

<script>
  // Avance automático: se lleva la posición en un número propio (scrollLeft redondea
  // y a velocidad baja se quedaría quieto). La fila tiene dos tandas iguales: al pasar
  // la primera, se vuelve atrás exactamente una tanda y el salto no se nota.
  document.querySelectorAll<HTMLElement>('[data-galeria]').forEach((sec) => {
    const fila = sec.querySelector<HTMLElement>('[data-galeria-fila]')!;
    const flechas = [...sec.querySelectorAll<HTMLButtonElement>('[data-galeria-ir]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const tanda = () => {
      const primeraCopia = fila.querySelector<HTMLElement>('[data-copia]');
      return primeraCopia ? primeraCopia.offsetLeft - (fila.firstElementChild as HTMLElement).offsetLeft : 0;
    };
    const envolver = (x: number) => {
      const t = tanda();
      if (!t) return x;
      if (x >= t) return x - t;
      if (x < 0) return x + t;
      return x;
    };

    flechas.forEach((b) =>
      b.addEventListener('click', () => {
        pausar(1800);
        const paso = Math.max(fila.clientWidth * 0.6, 316);
        const dir = Number(b.dataset.galeriaIr);
        // Hacia atrás desde el principio: primero se salta (sin que se note) a la segunda tanda.
        if (!reduce && dir < 0 && fila.scrollLeft < paso) fila.scrollLeft += tanda();
        fila.scrollTo({ left: fila.scrollLeft + dir * paso, behavior: reduce ? 'auto' : 'smooth' });
      }),
    );

    if (reduce) return;

    const velocidad = window.innerWidth < 1024 ? 28 : 36; // px por segundo
    let pos = fila.scrollLeft;
    let visible = false;
    let encima = false;
    let pausaHasta = 0;
    let ultimo = 0;

    function pausar(ms: number) {
      pausaHasta = performance.now() + ms;
    }

    const paso = (t: number) => {
      const dt = ultimo ? Math.min((t - ultimo) / 1000, 0.05) : 0;
      ultimo = t;
      if (visible && !encima && t > pausaHasta) {
        // Si la persona movió la fila a mano, se sigue desde donde la dejó.
        if (Math.abs(fila.scrollLeft - pos) > 2) pos = fila.scrollLeft;
        pos = envolver(pos + velocidad * dt);
        fila.scrollLeft = pos;
      } else {
        // Quieta o en manos de la persona: solo se mantiene dentro de la primera tanda.
        const corregida = envolver(fila.scrollLeft);
        if (corregida !== fila.scrollLeft) fila.scrollLeft = corregida;
        pos = fila.scrollLeft;
      }
      requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(fila);
    fila.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && (encima = true));
    fila.addEventListener('pointerleave', () => (encima = false));
    fila.addEventListener('pointerdown', () => pausar(2500));
    fila.addEventListener('touchstart', () => pausar(2500), { passive: true });
    fila.addEventListener('touchmove', () => pausar(2500), { passive: true });
    fila.addEventListener('wheel', (e) => Math.abs(e.deltaX) > Math.abs(e.deltaY) && pausar(2500), { passive: true });
  });
</script>
