---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { categorias, negocio } from '../data/site';
---

<section id="productos" class="overflow-x-clip px-5 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-[1200px]">
    <div class="max-w-[680px]" data-reveal>
      <p class="mb-3 text-sm font-semibold text-marca">Productos</p>
      <h2 class="text-4xl font-bold tracking-tight text-profundo lg:text-5xl">Lo que vas a encontrar en el almacén</h2>
      <p class="mt-4 text-lg text-texto-2">
        Renovamos la mercadería todo el tiempo. Si buscás algo puntual, escribinos por Instagram antes de venir.
      </p>
    </div>

    <ul data-desorden-grid class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:mt-16 lg:grid-cols-4 lg:gap-4">
      {
        categorias.map((c) => (
          <li
            data-desorden
            class="group rounded-3xl bg-white p-2 ring-1 ring-profundo/8 transition-[translate] duration-700 ease-fluid hover:-translate-y-1"
          >
            <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-menta">
              <Image
                src={c.foto}
                alt=""
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 280px, (min-width: 640px) 33vw, 50vw"
                quality={80}
                loading="lazy"
                class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-fluid group-hover:scale-105"
              />
            </div>
            <div class="px-2 pt-3 pb-2">
              <h3 class="text-base font-semibold text-profundo lg:text-lg">{c.nombre}</h3>
              <p class="mt-1 text-sm text-texto-2">{c.detalle}</p>
            </div>
          </li>
        ))
      }
      <li
        data-desorden
        class="col-span-2 flex flex-col justify-between gap-6 rounded-3xl bg-profundo p-6 text-white"
      >
        <Icon name="storefront" class="size-10 text-menta" />
        <div>
          <p class="text-lg font-semibold">¿Buscás algo que no está en la lista?</p>
          <a
            href={negocio.instagram}
            target="_blank"
            rel="noopener"
            class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-menta underline-offset-4 hover:underline"
          >
            Preguntanos por Instagram
            <Icon name="arrow-up-right" class="size-4" />
          </a>
        </div>
      </li>
    </ul>

    <p class="mt-6 text-sm text-texto-2">Imágenes ilustrativas. Los productos y las marcas disponibles pueden variar.</p>
  </div>
</section>
