---
// Productos contados por momento del día: la foto es ilustrativa, el sentido lo da el
// momento ("A la noche · La cena, resuelta"). Abajo de cada tarjeta, los rubros reales.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { momentos, negocio } from '../data/site';
---

<section id="productos" class="overflow-x-clip px-5 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-[1200px]">
    <div class="max-w-[680px]" data-reveal>
      <p class="mb-3 text-sm font-semibold text-marca-texto">Lo que vas a encontrar en el almacén</p>
      <h2 class="text-4xl font-bold tracking-tight text-profundo lg:text-5xl">
        Algo rico <br class="lg:hidden" />para cada momento
      </h2>
      <p class="mt-4 text-lg text-texto-2">
        Del primer mate a la cena. Renovamos la mercadería todo el tiempo: si buscás algo puntual, escribinos antes de
        venir.
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-3 lg:mt-16 lg:grid-cols-4 lg:gap-4">
      {
        momentos.map((m, i) => (
          <li data-reveal style={`--delay:${(i % 4) * 80}ms`} class="group transition-[translate] duration-700 ease-fluid hover:-translate-y-1">
            <div class="relative aspect-[4/5] overflow-hidden rounded-3xl bg-menta">
              <Image
                src={m.foto}
                alt=""
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 280px, 50vw"
                quality={80}
                loading="lazy"
                class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-fluid group-hover:scale-105"
              />
              {/* Velo sólido abajo (sin degradé) para que el título se lea sobre cualquier foto */}
              <div class="absolute inset-x-2 bottom-2 rounded-2xl bg-crema/95 p-3 backdrop-blur-sm lg:inset-x-3 lg:bottom-3 lg:p-4">
                <p class="text-[11px] font-semibold tracking-wide text-marca-texto uppercase lg:text-xs">{m.cuando}</p>
                <h3 class="mt-1 text-[15px] leading-tight font-bold text-profundo lg:text-lg">{m.titulo}</h3>
              </div>
            </div>
            <div class="px-1 pt-3">
              <p class="text-sm leading-snug text-texto-2">{m.linea}</p>
              <p class="mt-2 text-xs font-semibold text-texto-2">{m.rubros}</p>
            </div>
          </li>
        ))
      }
      <li
        data-reveal
        class="col-span-2 flex flex-col justify-between gap-6 rounded-3xl bg-profundo p-6 text-white lg:col-span-4 lg:flex-row lg:items-center lg:p-8"
      >
        <div class="flex items-center gap-4">
          <Icon name="storefront" class="size-10 shrink-0 text-menta" />
          <p class="text-lg font-semibold lg:text-xl">¿Buscás algo que no está acá? Preguntanos y te decimos si lo tenemos.</p>
        </div>
        <a
          href={negocio.instagram}
          target="_blank"
          rel="noopener"
          class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-menta underline-offset-4 hover:underline"
        >
          Preguntanos por Instagram
          <Icon name="arrow-up-right" class="size-4" />
        </a>
      </li>
    </ul>

  </div>
</section>
