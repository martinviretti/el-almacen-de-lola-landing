---
// Pie mínimo: quién es, dónde está y los dos links que faltan. Horarios, mapa y
// "Cómo llegar" ya están en Visitanos: acá no se repiten.
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import logo from '../assets/logo-lola-circulo.png';
import IconoMarca from './IconoMarca.astro';
import { negocio } from '../data/site';

const anio = new Date().getFullYear();
---

<footer class="bg-profundo px-5 py-10 text-white lg:px-10">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <Image src={logo} alt="" width={44} height={44} densities={[1, 2]} class="size-11 rounded-full" loading="lazy" />
      <div>
        <p class="font-semibold">{negocio.nombre}</p>
        <p class="text-sm text-white/70">{negocio.direccion}, {negocio.localidad}</p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-white/70">
      <a href={negocio.instagram} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-semibold text-white underline-offset-4 hover:underline">
        <IconoMarca name="instagram" class="size-4" />
        {negocio.instagramUsuario}
      </a>
      <a href={url('/privacidad')} class="underline-offset-4 hover:underline">Privacidad</a>
      <span>© {anio}</span>
    </div>
  </div>
</footer>
