---
import { tagline } from '../data/site';
const palabras = tagline.split(' ');
---

<section id="idea" aria-label="Nuestra idea" class="px-5 py-24 lg:px-10 lg:py-36">
  <p data-words class="mx-auto max-w-[880px] text-4xl font-semibold tracking-tight lg:text-6xl">
    {
      palabras.map((p, i) => (
        <>
          <span data-word>{p}</span>
          {i < palabras.length - 1 && ' '}
        </>
      ))
    }
  </p>
</section>
