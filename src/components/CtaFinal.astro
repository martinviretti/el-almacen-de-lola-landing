---
import Icon from './Icon.astro';
import { negocio } from '../data/site';
---

<section aria-label="Visitanos" class="fondo-hojas px-5 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-[680px] text-center" data-reveal>
    <h2 class="titulo-degrade text-4xl font-bold tracking-tight lg:text-6xl">
      Pasá por el almacén <br />
      y llevate algo rico
    </h2>
    <p class="mt-6 text-lg text-texto-2">{negocio.direccion}, {negocio.localidad}. De lunes a sábado.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={negocio.mapsDestino} target="_blank" rel="noopener" class="boton boton-principal">
        <Icon name="navigation-arrow" class="size-5" />
        Cómo llegar al almacén
      </a>
    </div>
  </div>
</section>
