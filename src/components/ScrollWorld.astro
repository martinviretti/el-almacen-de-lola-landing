---
// Recorrido "scroll world" sin video: la cámara arranca en la vereda, entra por la
// puerta y avanza por el almacén. Cada parada es una foto real que se revela con
// el scroll. Todas las paradas comparten la misma celda de la grilla, así que sin
// animaciones (o sin JS) se apilan solas como una lista normal.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { negocio, recorrido } from '../data/site';
---

<section id="recorrido" data-world aria-label="Recorrido por el almacén" style={`--paradas:${recorrido.length}`}>
  <div class="world-track">
    <div class="world-stage">
      <div class="fondo-hojas world-bg" data-world-bg aria-hidden="true"></div>

      <ol class="world-stops">
        {
          recorrido.map((parada, i) => (
            <li class="stop" data-stop={i} id={i === 0 ? 'top' : undefined}>
              <div class="stop-copy" data-stop-copy>
                {i === 0 ? (
                  <>
                    <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/80 px-3 py-2 text-sm font-semibold text-profundo ring-1 ring-profundo/10">
                      <span class="relative flex size-2">
                        <span data-estado-ping class="absolute inline-flex size-full rounded-full bg-marca opacity-60"></span>
                        <span data-estado-punto class="relative inline-flex size-2 rounded-full bg-marca"></span>
                      </span>
                      <span data-estado>Abrimos de lunes a sábado</span>
                    </p>
                    <h1 class="titulo-degrade text-4xl font-bold tracking-tight sm:text-5xl lg:text-7xl">
                      Lo rico de <br />
                      elegir natural
                    </h1>
                    <p class="hero-sub mt-4 max-w-[680px] text-base text-texto-2 sm:text-lg lg:mt-6">{parada.texto}</p>
                    <div class="mt-6 flex flex-wrap items-center gap-4 lg:mt-8">
                      <a href={negocio.mapsDestino} target="_blank" rel="noopener" class="boton boton-principal">
                        <Icon name="navigation-arrow" class="size-5" />
                        Cómo llegar al almacén
                      </a>
                      <p class="hidden text-sm text-texto-2 sm:block">
                        <strong class="font-semibold text-profundo">{negocio.seguidores}</strong> personas nos siguen en Instagram
                      </p>
                    </div>
                    <p data-scroll-hint class="world-hint mt-8 hidden items-center gap-2 text-sm font-semibold text-marca lg:flex">
                      <Icon name="arrow-down" class="size-4 animate-bounce" />
                      Deslizá para entrar al almacén
                    </p>
                  </>
                ) : (
                  <>
                    <p class="mb-3 text-sm font-semibold text-marca">
                      <span class="tabular-nums">{String(i).padStart(2, '0')}</span> · {parada.etiqueta}
                    </p>
                    <h2 class="text-3xl font-bold tracking-tight text-profundo sm:text-4xl lg:text-6xl">{parada.titulo}</h2>
                    <p class="mt-4 max-w-[520px] text-base text-texto-2 sm:text-lg lg:mt-6">{parada.texto}</p>
                  </>
                )}
              </div>

              <div class="stop-media grano" data-stop-media>
                <div class="stop-reveal" data-stop-reveal>
                  <Image
                    src={parada.foto}
                    alt={parada.alt}
                    widths={[parada.foto.width]}
                    sizes="(min-width: 1024px) 40vw, 90vw"
                    quality={86}
                    loading={i < 2 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    class="stop-img"
                    style={parada.foco ? `object-position:${parada.foco};transform-origin:${parada.foco}` : undefined}
                    data-stop-img
                  />
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="world-rail" aria-hidden="true">
        {
          recorrido.map((parada, i) => (
            <span class="rail-item" data-rail={i}>
              <span class="rail-bar"></span>
              <span class="rail-label">{parada.etiqueta}</span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Base: lista apilada (sin JS o con movimiento reducido) ---------- */
  .world-stage {
    position: relative;
  }
  .world-bg {
    position: absolute;
    inset: 0;
    opacity: 0.55;
  }
  .world-stops {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 64px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 112px 20px 64px;
  }
  .stop {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  .stop-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    border-radius: 9999px 9999px 24px 24px;
    background: var(--color-menta);
    box-shadow: 0 32px 64px -24px rgb(33 76 59 / 0.35);
  }
  .stop-reveal {
    position: absolute;
    inset: 0;
  }
  .stop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .world-rail {
    display: none;
  }
  :global(html:not(.motion)) .world-hint {
    display: none;
  }

  @media (min-width: 1024px) {
    .world-stops {
      padding: 160px 40px 96px;
    }
    .stop {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }

  /* ---------- Con movimiento: escenario fijo y paradas superpuestas ---------- */
  :global(html.motion) .world-track {
    /* 100svh del escenario + 90svh de scroll por cada cambio de parada + pausa final */
    height: calc(100svh + (var(--paradas) - 1) * 90svh + 40svh);
  }
  :global(html.motion) .world-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  :global(html.motion) .world-bg {
    inset: -20% 0;
    will-change: transform;
  }
  :global(html.motion) .world-stops {
    display: grid;
    height: 100%;
    padding: 0 20px;
    gap: 0;
  }
  :global(html.motion) .stop {
    grid-area: 1 / 1;
    grid-template-rows: 312px minmax(0, 1fr);
    align-items: stretch;
    gap: 16px;
    padding: 88px 0 48px;
    height: 100svh;
    pointer-events: none;
  }
  :global(html.motion) .stop-copy {
    align-self: end;
    will-change: transform, opacity, filter;
  }
  :global(html.motion) .stop-copy.is-active {
    pointer-events: auto;
  }
  :global(html.motion) .stop:not(:first-child) .stop-copy {
    opacity: 0;
  }
  :global(html.motion) .stop-media {
    height: 100%;
    width: auto;
    max-width: 100%;
    justify-self: center;
  }
  :global(html.motion) .stop-reveal {
    will-change: clip-path;
  }
  :global(html.motion) .stop:not(:first-child) .stop-reveal {
    clip-path: inset(100% 0% 0% 0%);
  }
  :global(html.motion) .stop:not(:first-child) .stop-media {
    box-shadow: none;
    background: transparent;
  }
  :global(html.motion) .stop-img {
    will-change: transform;
  }

  :global(html.motion) .world-rail {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 24px;
    display: flex;
    gap: 4px;
  }
  .rail-item {
    flex: 1;
  }
  .rail-bar {
    display: block;
    height: 4px;
    border-radius: 9999px;
    background: rgb(33 76 59 / 0.12);
    transition: background-color 700ms var(--ease-fluid);
  }
  .rail-item.is-active .rail-bar,
  .rail-item.is-done .rail-bar {
    background: var(--color-marca);
  }
  .rail-label {
    display: none;
  }

  /* Celulares bajitos: el hero pierde la bajada para que la foto conserve espacio */
  @media (max-width: 1023px) and (max-height: 720px) {
    :global(html.motion) .stop {
      grid-template-rows: 216px minmax(0, 1fr);
    }
    :global(html.motion) .hero-sub {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    :global(html.motion) .world-stops {
      padding: 0 40px;
    }
    :global(html.motion) .stop {
      grid-template-rows: none;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 64px;
      padding: 112px 0 96px;
    }
    :global(html.motion) .stop-copy {
      align-self: center;
    }
    :global(html.motion) .stop-media {
      height: min(100%, 760px);
      align-self: center;
    }
    :global(html.motion) .world-rail {
      left: 50%;
      right: auto;
      bottom: 32px;
      width: min(1120px, calc(100% - 80px));
      transform: translateX(-50%);
      gap: 12px;
    }
    .rail-label {
      display: block;
      margin-top: 8px;
      font-size: 0.75rem;
      line-height: 1rem;
      font-weight: 600;
      color: var(--color-texto-2);
      opacity: 0.6;
      transition: opacity 700ms var(--ease-fluid);
    }
    .rail-item.is-active .rail-label {
      opacity: 1;
      color: var(--color-profundo);
    }
  }
</style>
