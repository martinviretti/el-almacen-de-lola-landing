---
// Recorrido "scroll world": la fachada ocupa toda la pantalla; al bajar, la cámara
// entra por la puerta y el video del local avanza con el scroll dentro del arco.
// Cada parada tiene además su fotograma como afiche: se ve mientras carga el video,
// si el video no está disponible, y en la versión sin animación (lista apilada).
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { negocio, recorrido, videoRecorrido } from '../data/site';

const afiche = await getImage({ src: recorrido[1].foto, format: 'webp', width: recorrido[1].foto.width });
---

<section id="recorrido" data-world aria-label="Recorrido por el almacén" style={`--paradas:${recorrido.length}`}>
  <div class="world-track">
    <div class="world-stage">
      <div class="fondo-hojas world-bg" data-world-bg aria-hidden="true"></div>

      <ol class="world-stops">
        {
          recorrido.map((parada, i) => (
            <li class:list={['stop', i === 0 && 'stop-hero']} data-stop={i} data-tramo={parada.video?.join(',')} id={i === 0 ? 'top' : undefined}>
              <div class="stop-copy" data-stop-copy>
                {i === 0 ? (
                  <>
                    <p class="mb-4 text-sm font-semibold text-marca-texto">Tu almacén natural en Victoria</p>
                    <h1 class="titulo-degrade text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
                      Lo rico de <br />
                      elegir natural
                    </h1>
                    <p class="hero-sub mt-4 text-base text-texto-2 sm:text-lg">{parada.texto}</p>
                    <p class="hero-seguidores mt-4 text-sm text-texto-2">
                      <strong class="font-semibold text-profundo">{negocio.seguidores}</strong> personas ya nos siguen en Instagram
                    </p>
                    <p data-scroll-hint class="world-hint mt-6 flex items-center gap-2 text-sm font-semibold text-marca-texto">
                      <Icon name="arrow-down" class="size-4 animate-bounce" />
                      <span class="lg:hidden">Deslizá para verlo</span>
                      <span class="hidden lg:inline">Deslizá para entrar al almacén</span>
                    </p>
                  </>
                ) : (
                  <>
                    <p class="mb-3 text-sm font-semibold text-marca-texto">
                      <span class="tabular-nums">{String(i).padStart(2, '0')}</span> · {parada.etiqueta}
                    </p>
                    <h2 class="text-3xl font-bold tracking-tight text-profundo sm:text-4xl lg:text-6xl">{parada.titulo}</h2>
                    <p class="mt-4 max-w-[520px] text-base text-texto-2 sm:text-lg lg:mt-6">{parada.texto}</p>
                  </>
                )}
              </div>

              <div class:list={['stop-media', i > 0 && 'grano']} data-stop-media>
                <div class="stop-reveal" data-stop-reveal>
                  <Image
                    src={parada.foto}
                    alt={parada.alt}
                    widths={i === 0 ? [960, 1600, 2560].filter((w) => w < parada.foto.width).concat(parada.foto.width) : [parada.foto.width]}
                    sizes={i === 0 ? '100vw' : '(min-width: 1024px) 40vw, 90vw'}
                    quality={i === 0 ? 80 : 86}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    class="stop-img"
                    style={parada.foco ? `transform-origin:${parada.foco}` : undefined}
                    data-stop-img
                  />
                  {i === 0 && <div class="hero-velo" data-hero-velo aria-hidden="true"></div>}
                </div>
              </div>
            </li>
          ))
        }

        <li class="stop stop-video" aria-hidden="true" data-video-layer>
          <div class="stop-copy"></div>
          <div class="stop-media grano">
            <div class="stop-reveal" data-video-reveal>
              <video
                data-world-video
                data-src={videoRecorrido}
                poster={afiche.src}
                muted
                playsinline
                disablepictureinpicture
                preload="none"
                class="stop-img"
              ></video>
            </div>
          </div>
        </li>
      </ol>

      <div class="world-rail" aria-hidden="true">
        {
          recorrido.map((parada, i) => (
            <span class="rail-item" data-rail={i}>
              <span class="rail-bar"></span>
              <span class="rail-label">{parada.etiqueta}</span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Base: lista apilada (sin JS o con movimiento reducido) ---------- */
  .world-stage {
    position: relative;
  }
  .world-bg {
    position: absolute;
    inset: 0;
    opacity: 0.55;
  }
  .world-stops {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 64px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 112px 20px 64px;
  }
  .stop {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  .stop-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    border-radius: 9999px 9999px 24px 24px;
    background: var(--color-menta);
    box-shadow: 0 32px 64px -24px rgb(33 76 59 / 0.35);
  }
  .stop-hero .stop-media {
    aspect-ratio: 16 / 9;
    max-width: none;
    border-radius: 24px;
  }
  .stop-reveal {
    position: absolute;
    inset: 0;
  }
  .stop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stop-video,
  .world-rail,
  :global(html:not(.motion)) .world-hint {
    display: none;
  }

  @media (min-width: 1024px) {
    .world-stops {
      padding: 160px 40px 96px;
    }
    .stop {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }

  /* ---------- Con movimiento: escenario fijo y paradas superpuestas ---------- */
  :global(html.motion) .world-track {
    /* 100svh del escenario + 90svh de scroll por cada parada + pausa final */
    height: calc(100svh + (var(--paradas) - 1) * 90svh + 40svh);
  }
  :global(html.motion) .world-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  :global(html.motion) .world-bg {
    inset: -20% 0;
    will-change: transform;
  }
  :global(html.motion) .world-stops {
    /* static: la fachada absoluta toma de referencia el escenario a todo el ancho */
    position: static;
    display: grid;
    height: 100%;
    padding: 0 20px;
    gap: 0;
  }
  :global(html.motion) .stop {
    grid-area: 1 / 1;
    grid-template-rows: 312px minmax(0, 1fr);
    align-items: stretch;
    gap: 16px;
    padding: 88px 0 48px;
    height: 100svh;
    pointer-events: none;
  }
  :global(html.motion) .stop-copy {
    position: relative;
    z-index: 1;
    align-self: end;
    will-change: transform, opacity, filter;
  }
  :global(html.motion) .stop-copy.is-active {
    pointer-events: auto;
  }
  :global(html.motion) .stop:not(:first-child) .stop-copy {
    opacity: 0;
  }
  :global(html.motion) .stop-media {
    height: 100%;
    width: auto;
    max-width: 100%;
    justify-self: center;
  }
  :global(html.motion) .stop-reveal {
    will-change: clip-path;
  }
  :global(html.motion) .stop-img {
    will-change: transform;
  }

  /* Hero: la fachada a pantalla completa y el texto en una tarjeta encima */
  :global(html.motion) .stop-hero {
    grid-template-rows: minmax(0, 1fr) auto;
  }
  :global(html.motion) .stop-hero .stop-media {
    /* Enmarcada: deja aire arriba para el nav, así no tapa el logo del cartel */
    position: absolute;
    inset: 80px 12px 12px;
    width: auto;
    height: auto;
    max-width: none;
    aspect-ratio: auto;
    border-radius: 24px;
    box-shadow: 0 32px 64px -32px rgb(33 76 59 / 0.45);
    background: var(--color-crema);
    /* Sin esto, la alineación centrada del grid la achica a 0x0 por ser absoluta */
    justify-self: stretch;
    align-self: stretch;
    will-change: opacity;
  }
  :global(html.motion) .stop-hero .stop-img {
    object-position: 46% 50%;
    /* Fachada en segundo plano: suave para que la tarjeta se lea. Se enfoca al entrar. */
    filter: blur(3px) saturate(0.75);
  }
  :global(html.motion) .hero-velo {
    position: absolute;
    inset: 0;
    background: rgb(251 248 242 / 0.4);
    pointer-events: none;
  }
  :global(html.motion) .stop-hero .stop-copy {
    grid-row: 2;
    align-self: end;
    padding: 24px;
    border-radius: 24px;
    background: rgb(251 248 242 / 0.9);
    box-shadow: 0 24px 64px -24px rgb(33 76 59 / 0.45);
    backdrop-filter: blur(16px);
  }

  /* Paradas con fotograma: arrancan ocultas y se cruzan con opacidad */
  :global(html.motion) .stop:not(:first-child) .stop-media {
    box-shadow: none;
    background: transparent;
  }
  :global(html.motion) .stop:nth-child(n + 3):not(.stop-video) .stop-media {
    opacity: 0;
  }
  :global(html.motion) .stop:nth-child(2) .stop-reveal,
  :global(html.motion) .stop-video .stop-reveal {
    clip-path: circle(0% at 50% 50%);
  }

  /* Capa del video: encima de todas las paradas, visible cuando ya cargó */
  :global(html.motion) .stop-video {
    display: grid;
  }
  :global(html.motion) .stop-video .stop-media {
    background: transparent;
    box-shadow: none;
    opacity: 0;
    transition:
      opacity 700ms var(--ease-fluid),
      box-shadow 700ms var(--ease-fluid);
  }
  :global(html.motion) .stop-video.is-ready .stop-media {
    opacity: 1;
  }
  :global(html.motion) .stop-video.is-entered .stop-media {
    box-shadow: 0 32px 64px -24px rgb(33 76 59 / 0.35);
  }

  :global(html.motion) .world-rail {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 24px;
    display: flex;
    gap: 4px;
    z-index: 2;
    opacity: 0;
    transition: opacity 700ms var(--ease-fluid);
  }
  /* La barra de progreso aparece recién adentro del almacén, no sobre la fachada */
  :global(html.motion) [data-world].is-inside .world-rail {
    opacity: 1;
  }
  .rail-item {
    flex: 1;
  }
  .rail-bar {
    display: block;
    height: 4px;
    border-radius: 9999px;
    background: rgb(33 76 59 / 0.12);
    transition: background-color 700ms var(--ease-fluid);
  }
  .rail-item.is-active .rail-bar,
  .rail-item.is-done .rail-bar {
    background: var(--color-marca);
  }
  .rail-label {
    display: none;
  }

  /* En celular el recorrido es otro componente (RecorridoMovil.astro) */
  @media (max-width: 1023px) {
    #recorrido {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    :global(html.motion) .world-stops {
      padding: 0 40px;
    }
    :global(html.motion) .stop {
      grid-template-rows: none;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 64px;
      padding: 112px 0 96px;
    }
    :global(html.motion) .stop-copy {
      align-self: center;
    }
    :global(html.motion) .stop-media {
      height: min(100%, 760px);
      align-self: center;
    }
    :global(html.motion) .stop-hero .stop-media {
      inset: 88px 24px 24px;
      height: auto;
      border-radius: 32px;
    }
    :global(html.motion) .stop-hero .stop-img {
      object-position: 50% 50%;
    }
    /* La tarjeta va a la derecha, sobre la puerta del edificio: deja ver vidriera y cartel */
    :global(html.motion) .stop-hero .stop-copy {
      grid-row: 1;
      grid-column: 2;
      justify-self: end;
      max-width: 520px;
      padding: 40px;
    }
    :global(html.motion) .world-rail {
      left: 50%;
      right: auto;
      bottom: 32px;
      width: min(1120px, calc(100% - 80px));
      transform: translateX(-50%);
      gap: 12px;
    }
    .rail-label {
      display: block;
      margin-top: 8px;
      font-size: 0.75rem;
      line-height: 1rem;
      font-weight: 600;
      color: var(--color-texto-2);
      opacity: 0.6;
      transition: opacity 700ms var(--ease-fluid);
    }
    .rail-item.is-active .rail-label {
      opacity: 1;
      color: var(--color-profundo);
    }
  }
</style>
