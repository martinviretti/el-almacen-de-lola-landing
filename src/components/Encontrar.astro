---
// Qué vas a encontrar: las categorías en una grilla despareja, tipo revista. Cada foto dice
// para qué viene la gente. Reemplaza a "Algo rico para cada momento", a la galería y a los sellos.
import { Image } from 'astro:assets';
import { categorias } from '../data/site';
import { negocio } from '../data/negocio';

// Cuánto ocupa cada forma: en el celular la grilla es de 2 columnas, en escritorio de 4.
const FORMA = {
  grande: 'col-span-2 row-span-2',
  alta: 'row-span-2',
  ancha: 'col-span-2',
  chica: '',
};
const ANCHO = { grande: '(min-width: 1024px) 620px, 100vw', alta: '(min-width: 1024px) 300px, 50vw', ancha: '(min-width: 1024px) 620px, 100vw', chica: '(min-width: 1024px) 300px, 50vw' };
---

<section id="productos" class="px-5 py-20 lg:px-10 lg:py-28">
  <div class="mx-auto max-w-[1240px]">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="rotulo">Qué vas a encontrar</p>
        <h2 class="mt-4 text-4xl text-profundo lg:text-6xl">Toda la despensa <em>natural</em>, en un solo lugar</h2>
      </div>
      <p class="max-w-[44ch] text-base leading-relaxed text-texto-2 lg:col-span-5 lg:pb-2">
        Renovamos la mercadería todo el tiempo. Si buscás algo puntual, <a href={negocio.instagramMensaje} target="_blank" rel="noopener" class="font-semibold text-profundo underline decoration-marca/40 underline-offset-4 hover:decoration-profundo">escribinos antes de venir</a> y te decimos si lo tenemos.
      </p>
    </div>

    <ul class="mt-10 grid grid-flow-dense auto-rows-[168px] grid-cols-2 gap-3 sm:auto-rows-[220px] lg:mt-14 lg:grid-cols-4 lg:gap-4">
      {
        categorias.map((c, i) => (
          <li class:list={['foto group', FORMA[c.forma]]} data-reveal style={`--delay:${(i % 4) * 70}ms`}>
            <Image
              src={c.foto}
              alt={c.alt}
              widths={[400, 700, 1100]}
              sizes={ANCHO[c.forma]}
              class="transition-transform duration-[1200ms] ease-fluid group-hover:scale-[1.04]"
              style={c.encuadre ? `object-position:${c.encuadre}` : undefined}
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#14301f]/85 via-[#14301f]/10 to-transparent" />
            <div class="absolute inset-x-0 bottom-0 p-4 text-white lg:p-5">
              <h3 class:list={['font-[family-name:var(--font-display)] leading-tight font-medium', c.forma === 'grande' ? 'text-2xl lg:text-4xl' : 'text-lg lg:text-2xl']}>{c.nombre}</h3>
              <p class:list={['mt-1 max-w-[38ch] text-sm leading-snug text-white/85', c.forma === 'grande' || c.forma === 'ancha' ? '' : 'hidden sm:block']}>{c.linea}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
