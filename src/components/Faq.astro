---
// Preguntas frecuentes, todas a la vista en dos columnas (sin acordeón): son pocas y cortas.
import { preguntas } from '../data/site';
---

<section id="preguntas" class="px-5 py-20 lg:px-10 lg:py-28">
  <div class="mx-auto max-w-[1240px]">
    <div data-reveal>
      <p class="rotulo">Preguntas frecuentes</p>
      <h2 class="mt-4 text-4xl text-profundo lg:text-6xl">Lo que más nos <em>consultan</em></h2>
    </div>

    <dl class="mt-10 grid gap-x-14 gap-y-10 md:grid-cols-2 lg:mt-14">
      {
        preguntas.map((q, i) => (
          <div class="border-t border-profundo/12 pt-6" data-reveal style={`--delay:${(i % 2) * 90}ms`}>
            <dt class="text-lg font-semibold text-profundo">{q.p}</dt>
            <dd class="mt-2 max-w-[56ch] text-base leading-relaxed text-texto-2">{q.r}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
