---
// Franja chica de Instagram: logo, usuario y un botón. Sin las burbujas de destacadas.
import { Image } from 'astro:assets';
import logo from '../assets/logo-lola-circulo.png';
import IconoMarca from './IconoMarca.astro';
import { negocio } from '../data/site';
---

<section id="instagram" aria-labelledby="ig-titulo" class="px-5 py-10 lg:px-10 lg:py-14">
  <a
    href={negocio.instagram}
    target="_blank"
    rel="noopener"
    class="group mx-auto flex max-w-[1200px] items-center gap-4 rounded-full border border-arena bg-white py-3 pr-3 pl-3 transition-colors duration-700 ease-fluid hover:border-marca lg:gap-5 lg:py-4 lg:pr-4 lg:pl-4"
    data-reveal
  >
    <Image src={logo} alt="" width={64} height={64} class="size-12 shrink-0 rounded-full lg:size-14" />
    <span class="min-w-0 flex-1">
      <span id="ig-titulo" class="block truncate text-base font-bold text-profundo lg:text-lg">{negocio.instagramUsuario}</span>
      <span class="block truncate text-sm text-texto-2">Novedades<span class="hidden sm:inline">, recetas y sorteos</span></span>
    </span>
    <span class="flex shrink-0 items-center gap-2 rounded-full bg-profundo px-4 py-3 text-sm font-semibold text-white transition-transform duration-700 ease-fluid group-hover:scale-105 lg:px-6">
      <IconoMarca name="instagram" class="size-5" />
      Seguinos
    </span>
  </a>
</section>
