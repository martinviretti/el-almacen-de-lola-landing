---
// El recorrido: el video del local (20 s, sin personas ni textos) corre solo y en silencio cuando
// se ve en pantalla. Nunca secuestra el scroll. En escritorio, la lista de paradas al costado
// marca dónde va; en el celular, tipo historias: barritas arriba y tocar para avanzar o volver.
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { paradas, videoRecorrido, fotos } from '../data/site';

const poster = await getImage({ src: fotos.posterRecorrido, width: 720, format: 'webp' });
---

<section id="recorrido" class="px-5 py-20 lg:px-10 lg:py-28" data-recorrido={JSON.stringify(paradas)}>
  <div class="mx-auto grid max-w-[1240px] items-center gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5" data-reveal>
      <p class="rotulo">El recorrido</p>
      <h2 class="mt-4 text-4xl text-profundo lg:text-6xl">Pasá a dar una <em>vuelta</em></h2>
      <p class="mt-5 max-w-[42ch] text-lg leading-relaxed text-texto-2">Veinte segundos por la almacén, de la vereda a las heladeras.</p>

      <ol class="mt-8 hidden flex-col gap-1 lg:flex">
        {
          paradas.map((p, i) => (
            <li>
              <button type="button" class="parada group flex w-full items-center gap-4 rounded-2xl px-4 py-3 text-left transition-colors duration-500 ease-fluid hover:bg-white" data-ir={i}>
                <span class="w-6 text-sm font-semibold text-marca-texto tabular-nums">0{i + 1}</span>
                <span class="min-w-0 flex-1">
                  <span class="block text-xs font-semibold tracking-wide text-texto-2 uppercase">{p.etiqueta}</span>
                  <span class="block text-base font-semibold text-profundo">{p.titulo}</span>
                  <span class="parada-barra mt-2 block h-0.5 overflow-hidden rounded-full bg-profundo/10">
                    <span class="block h-full w-0 bg-profundo" data-barra />
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="lg:col-span-7" data-reveal style="--delay:120ms">
      <div class="marco relative mx-auto aspect-[3/4] max-w-[480px] overflow-hidden rounded-[32px] bg-profundo shadow-[0_40px_80px_-40px_rgb(33_76_59/0.6)] lg:aspect-auto lg:h-[min(76vh,720px)] lg:max-w-none lg:rounded-[40px]">
        {/* Fondo: el mismo cuadro, ampliado y desenfocado, para que el video vertical no quede en un recuadro vacío */}
        <img src={poster.src} alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 hidden size-full scale-110 object-cover opacity-60 blur-2xl lg:block" />
        <video
          class="absolute inset-0 size-full object-cover lg:relative lg:mx-auto lg:aspect-[3/4] lg:h-full lg:w-auto"
          src={videoRecorrido}
          poster={poster.src}
          muted
          loop
          playsinline
          preload="none"
          aria-label="Video del recorrido por la almacén: la entrada, las góndolas, el granel, el mostrador, las heladeras y la despensa"
          data-video></video>

        {/* Celular: barritas de historia y la parada actual */}
        <div class="pointer-events-none absolute inset-x-0 top-0 flex gap-1 p-3 lg:hidden" aria-hidden="true">
          {paradas.map(() => (
            <span class="h-[3px] flex-1 overflow-hidden rounded-full bg-white/35"><span class="block h-full w-0 bg-white" data-barra /></span>
          ))}
        </div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-5 pt-16 text-white lg:hidden" aria-live="polite">
          <p class="text-xs font-semibold tracking-wide uppercase opacity-80" data-etiqueta>{paradas[0].etiqueta}</p>
          <p class="mt-1 font-[family-name:var(--font-display)] text-2xl leading-tight" data-titulo>{paradas[0].titulo}</p>
        </div>
        {/* Tocar a la izquierda vuelve, a la derecha avanza (solo celular) */}
        <button type="button" class="absolute inset-y-0 left-0 w-1/3 lg:hidden" aria-label="Parada anterior" data-paso="-1"></button>
        <button type="button" class="absolute inset-y-0 right-0 w-2/3 lg:hidden" aria-label="Parada siguiente" data-paso="1"></button>

        <button
          type="button"
          class="absolute top-6 right-3 flex size-11 items-center justify-center rounded-full bg-white/85 text-profundo backdrop-blur-md transition-transform duration-500 ease-fluid active:scale-95 lg:top-4 lg:right-4"
          aria-label="Pausar el video"
          data-pausa>
          <span data-icono-pausa><Icon name="pause" class="size-5" /></span>
          <span data-icono-play hidden><Icon name="play" class="size-5" /></span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .parada[aria-current='true'] {
    background: #fff;
    box-shadow: 0 12px 30px -20px rgb(33 76 59 / 0.4);
  }
  .parada:not([aria-current='true']) .parada-barra {
    opacity: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-recorrido]').forEach((seccion) => {
    const paradas: Array<{ etiqueta: string; titulo: string; desde: number }> = JSON.parse(seccion.dataset.recorrido!);
    const video = seccion.querySelector<HTMLVideoElement>('[data-video]')!;
    const botones = [...seccion.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    const barrasLista = botones.map((b) => b.querySelector<HTMLElement>('[data-barra]')!);
    const barrasHistoria = [...seccion.querySelectorAll<HTMLElement>('.marco [data-barra]')];
    const etiqueta = seccion.querySelector<HTMLElement>('[data-etiqueta]')!;
    const titulo = seccion.querySelector<HTMLElement>('[data-titulo]')!;
    const pausa = seccion.querySelector<HTMLButtonElement>('[data-pausa]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Pausado a mano: no se vuelve a prender solo al volver a la pantalla.
    let pausadoAMano = reduce;
    let actual = -1;

    const fin = (i: number) => paradas[i + 1]?.desde ?? (video.duration || 21.85);
    const indice = (t: number) => paradas.reduce((k, p, i) => (t >= p.desde ? i : k), 0);

    function pintar() {
      const t = video.currentTime;
      const i = indice(t);
      if (i !== actual) {
        actual = i;
        botones.forEach((b, k) => b.setAttribute('aria-current', String(k === i)));
        etiqueta.textContent = paradas[i].etiqueta;
        titulo.textContent = paradas[i].titulo;
      }
      const avance = Math.min(1, Math.max(0, (t - paradas[i].desde) / (fin(i) - paradas[i].desde)));
      barrasLista.forEach((b, k) => (b.style.width = k === i ? `${avance * 100}%` : '0%'));
      barrasHistoria.forEach((b, k) => (b.style.width = k < i ? '100%' : k === i ? `${avance * 100}%` : '0%'));
    }
    const bucle = () => {
      pintar();
      if (!video.paused) requestAnimationFrame(bucle);
    };

    const reproducir = () => video.play().catch(() => {});
    function marcarPausa() {
      const quieto = video.paused;
      pausa.setAttribute('aria-label', quieto ? 'Reproducir el video' : 'Pausar el video');
      pausa.querySelector<HTMLElement>('[data-icono-pausa]')!.hidden = quieto;
      pausa.querySelector<HTMLElement>('[data-icono-play]')!.hidden = !quieto;
    }
    video.addEventListener('play', () => {
      marcarPausa();
      requestAnimationFrame(bucle);
    });
    video.addEventListener('pause', marcarPausa);
    video.addEventListener('seeked', pintar);
    marcarPausa();
    pintar();

    pausa.addEventListener('click', () => {
      pausadoAMano = !video.paused;
      if (video.paused) reproducir();
      else video.pause();
    });
    const ir = (i: number) => {
      video.currentTime = paradas[(i + paradas.length) % paradas.length].desde + 0.01;
      if (!pausadoAMano) reproducir();
      pintar();
    };
    botones.forEach((b) => b.addEventListener('click', () => ir(Number(b.dataset.ir))));
    seccion.querySelectorAll<HTMLButtonElement>('[data-paso]').forEach((b) => b.addEventListener('click', () => ir(actual + Number(b.dataset.paso))));

    // Corre solo cuando se ve: no gasta datos ni batería fuera de pantalla.
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !pausadoAMano) reproducir();
        else if (!e.isIntersecting) video.pause();
      },
      { threshold: 0.4 },
    ).observe(video);
  });
</script>
