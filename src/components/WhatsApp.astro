---
// Botón flotante de WhatsApp. Sin número cargado abre WhatsApp con el mensaje
// listo para elegir el chat; con número, va directo al chat del almacén.
import logo from '@phosphor-icons/core/assets/fill/whatsapp-logo-fill.svg?raw';
import { negocio } from '../data/negocio';

const href = `https://wa.me/${negocio.whatsapp}?text=${encodeURIComponent(negocio.whatsappMensaje)}`;
const svg = logo.replace('<svg ', '<svg class="size-7" aria-hidden="true" focusable="false" ');
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Escribinos por WhatsApp"
  title="Escribinos por WhatsApp"
  class="whatsapp fixed right-4 bottom-4 z-40 flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_12px_32px_-8px_rgb(0_0_0/0.35)] transition-transform duration-700 ease-fluid hover:scale-105 active:scale-95 lg:right-6 lg:bottom-6"
>
  <Fragment set:html={svg} />
</a>
