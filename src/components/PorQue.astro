---
// Por qué Lola: tres diferencias contadas con foto, alternando lados. La de atención lleva una
// opinión real de Google; la de etiquetas, los sellos que la gente busca en el envase.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { razones, sellos, tagline } from '../data/site';

// "Te ayudamos a *elegir*" → la palabra entre asteriscos va en itálica.
const conItalica = (t: string) => t.replace(/\*(.+?)\*/g, '<em>$1</em>');
---

<section id="por-que" class="bg-menta-suave/60 px-5 py-20 lg:px-10 lg:py-28">
  <div class="mx-auto max-w-[1240px]">
    <div class="max-w-[820px]" data-reveal>
      <p class="rotulo">Por qué Lola</p>
      <p class="mt-4 font-[family-name:var(--font-display)] text-3xl leading-[1.15] tracking-tight text-profundo lg:text-5xl">{tagline}</p>
    </div>

    <div class="mt-14 flex flex-col gap-16 lg:mt-20 lg:gap-24">
      {
        razones.map((r, i) => (
          <article class="grid items-center gap-8 lg:grid-cols-12 lg:gap-14">
            <div class:list={['foto grano aspect-[4/3] lg:col-span-6 lg:aspect-[5/6]', i % 2 ? 'lg:order-2 lg:col-start-7' : '']} data-reveal>
              <Image src={r.foto} alt={r.alt} widths={[600, 900]} sizes="(min-width: 1024px) 580px, 100vw" />
            </div>
            <div class:list={['lg:col-span-5', i % 2 ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8']} data-reveal style="--delay:120ms">
              <p class="text-sm font-semibold text-marca-texto tabular-nums">
                0{i + 1} · {r.rotulo}
              </p>
              <h2 class="mt-3 text-4xl text-profundo lg:text-5xl" set:html={conItalica(r.titulo)} />
              <p class="mt-5 max-w-[48ch] text-lg leading-relaxed text-texto-2">{r.texto}</p>
              {r.cita && (
                <figure class="mt-7 border-l-2 border-marca/40 pl-5">
                  <blockquote class="font-[family-name:var(--font-display)] text-xl text-profundo italic">“{r.cita.texto}”</blockquote>
                  <figcaption class="mt-2 text-sm font-semibold text-texto-2">{r.cita.autor} · en Google</figcaption>
                </figure>
              )}
              {r.sellos && (
                <ul class="mt-7 flex flex-wrap gap-2">
                  {sellos.map((s) => (
                    <li class="flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-sm font-semibold text-profundo ring-1 ring-profundo/10">
                      <Icon name={s.icono} class="size-4 text-marca-texto" />
                      {s.nombre}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
