---
// Visitanos: si está abierto, dónde queda, cómo llegar y cómo pagar. A la derecha, la fachada
// (para reconocerla desde la vereda) y el mapa.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import IconoMarca from './IconoMarca.astro';
import { negocio, horarios, hrefWhatsApp } from '../data/negocio';
import { fotos } from '../data/site';

// Lunes primero, domingo al final. `i` es el día de la semana (0 = domingo) para marcar hoy.
const semana = [...horarios.map((h, i) => ({ ...h, i })).slice(1), { ...horarios[0], i: 0 }];
---

<section id="visitanos" class="bg-menta-suave px-5 py-20 lg:px-10 lg:py-28">
  <div class="mx-auto max-w-[1240px]">
    <div data-reveal>
      <p class="rotulo">Visitanos</p>
      <h2 class="mt-4 text-4xl text-profundo lg:text-6xl">Te esperamos en <em>Victoria</em></h2>
    </div>

    <div class="mt-10 grid gap-4 lg:mt-14 lg:grid-cols-12 lg:gap-6">
      <div class="min-w-0 rounded-[28px] bg-white p-6 lg:col-span-5 lg:p-9" data-reveal>
        <p class="flex items-center gap-2.5 text-base font-semibold text-profundo" data-estado>
          <span class="punto-estado" aria-hidden="true"></span>
          <span data-estado-texto>Lunes a sábado</span>
        </p>

        <p class="mt-6 font-[family-name:var(--font-display)] text-3xl leading-tight text-profundo">{negocio.direccion}</p>
        <p class="mt-1 text-base text-texto-2">{negocio.localidad}, {negocio.provincia}</p>

        <div class="mt-6 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
          <a href={negocio.mapsDestino} target="_blank" rel="noopener" class="boton boton-principal col-span-2">
            <Icon name="navigation-arrow" class="size-5" />
            Cómo llegar
          </a>
          <a href={hrefWhatsApp} target="_blank" rel="noopener" class="boton boton-secundario" aria-label="Escribinos por WhatsApp">
            <IconoMarca name="whatsapp" class="size-5" />
            WhatsApp
          </a>
          <a href={negocio.instagramMensaje} target="_blank" rel="noopener" class="boton boton-secundario" aria-label="Escribinos por Instagram">
            <IconoMarca name="instagram" class="size-5" />
            Instagram
          </a>
        </div>

        <h3 class="mt-9 text-sm font-semibold text-marca-texto">Horarios</h3>
        <dl class="mt-2 divide-y divide-profundo/10">
          {
            semana.map((h) => (
              <div class="dia flex justify-between gap-4 py-2.5 text-[15px]" data-dia={h.i}>
                <dt class="text-texto-2">{h.dia}</dt>
                <dd class="font-semibold text-profundo tabular-nums">{h.abre === null ? 'Cerrado' : `${h.abre} a ${h.cierra} h`}</dd>
              </div>
            ))
          }
        </dl>

        <h3 class="mt-9 text-sm font-semibold text-marca-texto">Medios de pago</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            negocio.pagos.map((p) => (
              <li class="flex items-center gap-2 rounded-full bg-menta-suave px-3.5 py-2 text-sm font-semibold text-profundo">
                {p.id === 'mercadopago' ? <IconoMarca name="mercadopago" class="size-5" /> : <Icon name={p.id === 'efectivo' ? 'money' : 'credit-card'} class="size-5" />}
                {p.nombre}
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-sm font-semibold text-marca-texto">{negocio.pagosNota}</p>
      </div>

      <div class="grid min-w-0 gap-4 lg:col-span-7 lg:grid-rows-[auto_1fr] lg:gap-6">
        <figure class="foto grano aspect-[16/9]" data-reveal style="--delay:100ms">
          <Image src={fotos.fachada} alt="Frente de La Almacén de Lola: cartel verde con el logo y la vidriera" widths={[700, 1100, 1600]} sizes="(min-width: 1024px) 700px, 100vw" />
          <figcaption class="absolute bottom-4 left-4 rounded-full bg-white/85 px-4 py-2 text-sm font-semibold text-profundo backdrop-blur-md">Buscá el cartel verde sobre Av. Perón</figcaption>
        </figure>
        {/* El navegador lo carga recién cuando la persona llega a esta parte (loading="lazy") */}
        <div class="relative min-h-[300px] min-w-0 overflow-hidden rounded-[28px] bg-white ring-1 ring-profundo/10" data-reveal style="--delay:180ms">
          <iframe
            src={negocio.mapsEmbed}
            title={`Mapa con la ubicación de ${negocio.nombre}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 size-full border-0"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hoy, resaltado en la lista de horarios */
  .dia.es-hoy dt,
  .dia.es-hoy dd {
    color: var(--color-profundo);
    font-weight: 700;
  }
  .dia.es-hoy dt::after {
    content: ' · hoy';
    font-weight: 600;
    color: var(--color-marca-texto);
  }
</style>

<script>
  const hoy = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(
    new Intl.DateTimeFormat('en-US', { timeZone: 'America/Argentina/Buenos_Aires', weekday: 'short' }).format(new Date()),
  );
  document.querySelector(`.dia[data-dia="${hoy}"]`)?.classList.add('es-hoy');
</script>
