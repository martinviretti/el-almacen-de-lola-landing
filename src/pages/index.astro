---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ScrollWorld from '../components/ScrollWorld.astro';
import Tagline from '../components/Tagline.astro';
import Galeria from '../components/Galeria.astro';
import InstagramLola from '../components/InstagramLola.astro';
import Productos from '../components/Productos.astro';
import Marcas from '../components/Marcas.astro';
import Visitanos from '../components/Visitanos.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import Flotantes from '../components/Flotantes.astro';
import RecorridoMovil from '../components/RecorridoMovil.astro';
---

<Base schema>
  <Nav />
  <main id="contenido">
    <ScrollWorld />
    <RecorridoMovil />
    <Tagline />
    <Galeria />
    <InstagramLola />
    <Marcas />
    <Productos />
    <Visitanos />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
  <Flotantes />
</Base>

<script>
  import '../scripts/motion';
</script>
