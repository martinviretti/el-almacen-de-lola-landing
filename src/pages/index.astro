---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Encontrar from '../components/Encontrar.astro';
import PorQue from '../components/PorQue.astro';
import Recorrido from '../components/Recorrido.astro';
import Opiniones from '../components/Opiniones.astro';
import InstagramLola from '../components/InstagramLola.astro';
import Visitanos from '../components/Visitanos.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import BarraMovil from '../components/BarraMovil.astro';
---

<Base schema>
  <Nav />
  <main id="contenido">
    <Hero />
    <Encontrar />
    <PorQue />
    <Recorrido />
    <Opiniones />
    <InstagramLola />
    <Visitanos />
    <Faq />
  </main>
  <Footer />
  <BarraMovil />
</Base>

<script>
  import '../scripts/motion';
</script>
