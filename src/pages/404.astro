---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Página no encontrada | La Almacén de Lola" noindex>
  <main id="contenido" class="flex min-h-svh items-center justify-center px-5 py-24">
    <div class="max-w-[680px] text-center">
      <p class="text-sm font-semibold text-marca-texto">Error 404</p>
      <h1 class="mt-3 text-5xl text-profundo lg:text-7xl">
        Esta góndola <br />
        está <em>vacía</em>
      </h1>
      <p class="mt-6 text-lg text-texto-2">La página que buscás no existe o cambió de lugar.</p>
      <a href={url('/')} class="boton boton-principal mt-8">
        <Icon name="arrow-left" class="size-5" />
        Volver a la almacén
      </a>
    </div>
  </main>
</Base>
